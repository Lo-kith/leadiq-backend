{
  "name": "leadiq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LeadIQ backend - REST API for smart lead qualification and analytics",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
