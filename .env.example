# Server
PORT=3000
NODE_ENV=development

# Local MongoDB (default). Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/leadiq

# CORS allowed origins (frontend dev + production)
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_PROD=https://your-frontend.example.com

# CSV upload limit in megabytes
MAX_CSV_SIZE_MB=20

# Ollama (local AI used by "Ask Your Leads")
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_STATUS_TIMEOUT_MS=3000
# Max number of lead records sent as context to the model
OLLAMA_MAX_LEADS=15
# Max number of prior chat messages kept per request
OLLAMA_MAX_HISTORY=10
# Keep the model loaded in memory between requests (avoids slow cold starts).
OLLAMA_KEEP_ALIVE=30m
# Preload the model in the background when the Ask page checks status.
OLLAMA_WARM=true
# Cap on generated tokens (thinking + answer). qwen3 is a reasoning model;
# limiting this bounds worst-case latency. ~13 tok/s locally, so 1600 ~= 2 min.
OLLAMA_NUM_PREDICT=2400
